{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nucleoid/total-recall/eval/schema.json",
  "title": "Total Recall binary retrieval evaluation dataset v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "namespaces", "cases"],
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 2000 },
    "identity_mode": { "enum": ["source_key", "local_uuid"], "default": "source_key" },
    "namespaces": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
    "defaults": { "$ref": "#/$defs/defaults" },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "defaults": {
      "type": "object", "additionalProperties": false,
      "properties": { "k": { "type": "integer", "minimum": 1, "maximum": 50 }, "threshold": { "type": "number", "minimum": -1, "maximum": 1 } }
    },
    "identity": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["source_key"], "properties": { "source_key": { "type": "string", "minLength": 1, "maxLength": 512 } } },
        { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "type": "string", "format": "uuid" } } }
      ]
    },
    "filters": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "source": { "type": "string", "minLength": 1 },
        "after": { "type": "string", "format": "date-time" },
        "before": { "type": "string", "format": "date-time" },
        "valid_at": { "type": "string", "format": "date-time" },
        "media": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "services": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "event_types": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "event_after": { "type": "string", "format": "date-time" },
            "event_before": { "type": "string", "format": "date-time" },
            "event_before_exclusive": { "type": "boolean" }
          }
        }
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "query"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$", "maxLength": 200 },
        "query": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "k": { "type": "integer", "minimum": 1, "maximum": 50 },
        "threshold": { "type": "number", "minimum": -1, "maximum": 1 },
        "filters": { "$ref": "#/$defs/filters" },
        "relevant": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/identity" } },
        "expect_no_results": { "type": "boolean" }
      }
    }
  }
}
