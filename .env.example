# Owner-only URL for npm run provision and npm run migrate. Never provide it to runtime services.
MIGRATION_DATABASE_URL=postgresql://<owner-role>:<owner-password>@localhost:5432/<database>
# One-shot input for npm run provision; do not retain it in long-running service environments.
APP_DATABASE_PASSWORD=<new-app-password>
# Optional bounded advisory-lock wait for npm run migrate (default 30000; range 1..600000 ms).
MIGRATION_LOCK_TIMEOUT_MS=30000
# MAINTENANCE_DATABASE_URL is optional and operator-only for all-row maintenance.
# Re-embedding may use a one-command REEMBED_DATABASE_URL override first.
# Compatibility order: REEMBED_DATABASE_URL (reembed only), MAINTENANCE_DATABASE_URL,
# MIGRATION_DATABASE_URL, deprecated OWNER_DATABASE_URL, then DATABASE_URL.
# Every selected connection must pass the all-row/BYPASSRLS preflight.
# Do not add maintenance credentials to long-running service environments.
# MAINTENANCE_DATABASE_URL=
# OWNER_DATABASE_URL= # deprecated compatibility only
DATABASE_URL=postgresql://total_recall_app:<app-password>@localhost:5432/<database>

# IANA zone used for media summary calendar dates. Optional; defaults to UTC.
MEDIA_TIME_ZONE=America/Chicago

# Required by npm run preseed and the watcher.
# OPENCLAW_WORKSPACE=/absolute/path/to/.openclaw/workspace
# Optional OpenClaw import overrides; defaults are beneath OPENCLAW_WORKSPACE.
# OPENCLAW_CORTEX_CONTENT=/absolute/path/to/cortex/content
# OPENCLAW_SECOND_BRAIN=/absolute/path/to/second-brain

# Required by npm run preseed:claude after migration 023 is applied.
# Must contain conversations.json and memories.json.
# CLAUDE_IMPORTS_DIR=/absolute/path/to/claude-export

# Required canonical profile for every runtime and embedding maintenance command (named explicitly).
# JSON references credential/URL variable names; never put secrets in the JSON itself.
# Missing or mismatched values fail closed; there is no implicit provider fallback.
EMBEDDING_CURRENT_PROFILE=gemini-production
EMBEDDING_PROFILES_JSON={"gemini-production":{"provider":"gemini","model":"gemini-embedding-2-preview","dimensions":768,"apiKeyEnv":"GEMINI_API_KEY"}}
GEMINI_API_KEY=your-gemini-api-key-here
# Temporary migration example (enable only for truthfully labelled eligible rows):
# EMBEDDING_PROFILES_JSON={"gemini-production":{"provider":"gemini","model":"gemini-embedding-2-preview","dimensions":768,"apiKeyEnv":"GEMINI_API_KEY"},"nomic-legacy":{"provider":"ollama","model":"nomic-embed-text","dimensions":768,"baseUrlEnv":"NOMIC_OLLAMA_URL"}}
# NOMIC_OLLAMA_URL=http://127.0.0.1:11434
# Pre-profile upgrade compatibility only; remove after switching to the named settings above.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2-preview
EMBEDDING_DIMENSIONS=768

# memory_store near-duplicate cosine threshold. Optional; default 0.95, valid range [0,1].
MEMORY_DEDUPE_THRESHOLD=0.95

# Expired-memory hard-delete batch size used before decay (default 1000; range 1..100000).
TTL_PURGE_BATCH_SIZE=1000

# Optional bounded re-embedding controls. Empty namespaces means every namespace.
# REEMBED_DATABASE_URL=postgresql://<owner-role>:<owner-password>@localhost:5432/<database>
# REEMBED_NAMESPACES=personal,work,projects,financial,shared,media
# REEMBED_BATCH_SIZE=10
# REEMBED_DELAY_MS=50
# REEMBED_MAX_ERRORS=0 # hard provider/response/database errors; concurrent changes are retried on the next pass
# REEMBED_FULL_REPAIR=false

# Required by npm run preseed:chatgpt after migration 023 is applied.
# The directory may contain conversations.json and conversations-<digits>.json exports.
# CHATGPT_IMPORTS_DIR=/absolute/path/to/chatgpt-export

# Required by npm run preseed:gemini after migration 023 is applied.
# GEMINI_TAKEOUT_HTML_PATH=/absolute/path/to/Takeout/My Activity/Gemini Apps/MyActivity.html

# HNSW search breadth for pgvector recall queries. Valid range: 1..1000; default: 200 when unset or blank.
HNSW_EF_SEARCH=200
# Superseded-row demotion is a separate reversible rollout step and defaults off.
SUPERSEDED_SEARCH_DEMOTION_ENABLED=false
# Applied only when the gate above is exactly true. Range (0,1], default 0.25.
SUPERSEDED_SCORE_FACTOR=0.25
# Finalized search schema capabilities are cached per DB pool generation for this TTL (1..300000 ms).
# valid_at still refreshes the finalization proof on every request. Default: 30000.
SEARCH_SCHEMA_CAPABILITY_TTL_MS=30000

# #53 contradiction processing is independently approved and disabled by default.
# Embedding credentials and approvals for any other generative feature never enable it.
CONTRADICTION_CLASSIFICATION_ENABLED=false
# CONTRADICTION_PROCESSING_APPROVED=true
# CONTRADICTION_PROVIDER=generation-gateway-name
# CONTRADICTION_MODEL=reviewed-model-id
# CONTRADICTION_GENERATION_ENDPOINT=https://approved-gateway.example/v1/generate
# CONTRADICTION_GENERATION_API_KEY=
# CONTRADICTION_PROVIDER_MODEL_APPROVED=true
# CONTRADICTION_PRIVACY_APPROVED=true
# CONTRADICTION_RETENTION_APPROVED=true
# CONTRADICTION_TRAINING_APPROVED=true
# CONTRADICTION_APPROVED_NAMESPACE=low-sensitivity-namespace
# CONTRADICTION_SCOPE_APPROVED=true # initial scope is always access_level=normal
# Process-lifetime conservative reservation cap; this is not exact provider billing and resets on restart.
# CONTRADICTION_COST_BUDGET_USD=10
# CONTRADICTION_COST_BUDGET_APPROVED=true
# All three estimate fields are required. Set reviewed upper bounds for the exact provider/model.
# A request reserves base + actual bounded input bytes + maximum output bytes before egress; no refunds.
# CONTRADICTION_ESTIMATED_REQUEST_COST_USD=0.001
# CONTRADICTION_ESTIMATED_INPUT_COST_USD_PER_MILLION_BYTES=1
# CONTRADICTION_ESTIMATED_OUTPUT_COST_USD_PER_MILLION_BYTES=4
# Process-local shadow backpressure. Defaults: 2 in flight and 8 queued; queued work is dropped on shutdown.
# CONTRADICTION_SHADOW_MAX_IN_FLIGHT=2
# CONTRADICTION_SHADOW_MAX_QUEUED=8
# CONTRADICTION_TIMEOUT_MS=10000
# CONTRADICTION_MUTATION_CONFIDENCE=0.95
# Automatic mutation additionally requires reviewed shadow metrics and an exact environment match.
CONTRADICTION_AUTO_MUTATION_ENABLED=false
# CONTRADICTION_MUTATION_APPROVED=true
# CONTRADICTION_SHADOW_METRICS_REVIEWED=true
# DEPLOYMENT_ENVIRONMENT=production
# CONTRADICTION_MUTATION_ENVIRONMENT=production

# #54 consolidation is independently disabled unless an owner-only policy file
# is explicitly configured for the scheduled process. Selection-only mode needs
# neither this file nor a generation credential. Never reuse GEMINI_API_KEY as
# consolidation approval or as the policy's dedicated credential.
# CONSOLIDATION_API_KEY=tr_dedicated_key_with_read_write_delete_consolidate
# CONSOLIDATION_POLICY_FILE=/owner-only/path/consolidation-policy-v1.json
# The strict policy names its own credential environment variable, for example:
# CONSOLIDATION_GENERATION_API_KEY=
# DEPLOYMENT_ENVIRONMENT=production

# #56 semantic subscriptions are additive but both creation and delivery are
# independently disabled by default. Keys are comma-separated key-id:base64
# AES-256 keys; encrypt with the first and retain older keys for decryption.
MEMORY_SUBSCRIPTION_CREATION_ENABLED=false
WEBHOOK_DELIVERY_ENABLED=false
# WEBHOOK_ENCRYPTION_KEYS=2026-01:<base64-of-exactly-32-random-bytes>,2025-12:<previous-key>
# Dedicated enabled API key with admin/read permissions and every deliverable namespace.
# WEBHOOK_WORKER_API_KEY=tr_dedicated_worker_key
# WEBHOOK_DELIVERY_CONCURRENCY=4 # 1..32
# WEBHOOK_DELIVERY_TIMEOUT_MS=5000 # 100..30000
# WEBHOOK_MAX_RESPONSE_BYTES=16384 # 1..1048576
# Destinations are always public HTTPS on port 443. There is no private-network bypass.

# Bounded owner-run validity backfill controls.
# MEMORY_VALIDITY_BATCH_SIZE=1000
# MEMORY_VALIDITY_MAX_BATCHES=100
