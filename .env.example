MIGRATION_DATABASE_URL=postgresql://total_recall:total_recall_dev@localhost:5432/total_recall
# Optional bounded advisory-lock wait for npm run migrate (default 30000; range 1..600000 ms).
MIGRATION_LOCK_TIMEOUT_MS=30000
# MAINTENANCE_DATABASE_URL is optional and operator-only for all-row maintenance.
# Compatibility order: MAINTENANCE_DATABASE_URL, MIGRATION_DATABASE_URL,
# deprecated OWNER_DATABASE_URL, then DATABASE_URL (which must pass the all-row preflight).
# Do not add maintenance credentials to long-running service environments.
# MAINTENANCE_DATABASE_URL=
# OWNER_DATABASE_URL= # deprecated compatibility only
DATABASE_URL=postgresql://total_recall_app:total_recall_app_dev@localhost:5432/total_recall

# Optional watcher root. When absent, keeps the Linux compatibility default:
# /home/fuego/.openclaw/workspace
# OPENCLAW_WORKSPACE=C:\Users\your-name\.openclaw\workspace

# Canonical profile for preseed/repair, which remain gated on #9/#61.
# Live paths still use their existing Gemini-key/Ollama selection until that coordinated cutover.
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
EMBEDDING_MODEL=gemini-embedding-2-preview
EMBEDDING_DIMENSIONS=768

# HNSW search breadth for pgvector recall queries. Valid range: 1..1000; default: 200 when unset or blank.
HNSW_EF_SEARCH=200
