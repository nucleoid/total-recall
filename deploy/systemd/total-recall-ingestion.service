[Unit]
Description=Total Recall Memory Ingestion Worker
After=postgresql.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/.local/share/total-recall/current
ExecStart=/usr/bin/node --import tsx %h/.local/share/total-recall/current/scripts/ingestion-worker.ts --concurrency 4
EnvironmentFile=%h/projects/total-recall/.env
Restart=always
RestartSec=3
# SIGTERM drains in-flight embeddings (bounded by EMBEDDING_TIMEOUT_MS, at most 120s) before exit.
KillSignal=SIGTERM
TimeoutStopSec=150

[Install]
WantedBy=default.target
