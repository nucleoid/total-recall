[Unit]
Description=Total Recall durable ingestion worker
After=postgresql.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/.local/share/total-recall/current
ExecStart=/usr/bin/node --import tsx %h/.local/share/total-recall/current/scripts/ingestion-worker.ts --concurrency 4
EnvironmentFile=%h/projects/total-recall/.env
Restart=on-failure
RestartSec=5
TimeoutStopSec=160

[Install]
WantedBy=default.target
