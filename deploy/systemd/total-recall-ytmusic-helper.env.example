# Fuego-only private helper. Install mode 0600.
YTMUSIC_HELPER_HOST=replace-with-private-fuego-address
YTMUSIC_HELPER_PORT=3011
YTMUSIC_HELPER_BEARER_TOKEN=replace-with-dedicated-random-token
YTMUSIC_HELPER_PYTHON=/home/fuego/projects/total-recall/.venv/bin/python3
YTMUSIC_HELPER_SCRIPT=/home/fuego/.local/share/total-recall/current/scripts/ytmusic_helper.py
YTMUSIC_HELPER_TLS_CERT=/etc/total-recall/ytmusic-helper.crt
YTMUSIC_HELPER_TLS_KEY=/etc/total-recall/ytmusic-helper.key
YTMUSIC_HELPER_TIMEOUT_MS=60000
YTMUSIC_HELPER_MAX_REQUEST_BYTES=262144
YTMUSIC_HELPER_MAX_RESPONSE_BYTES=2097152
