# Private Fuego adapter only. Install mode 0600; never copy the OpenClaw credential to Dappnode.
GENERATION_GATEWAY_HOST=127.0.0.1
GENERATION_GATEWAY_PORT=3010
GENERATION_GATEWAY_BEARER_TOKEN=replace-with-dedicated-worker-to-adapter-token
GENERATION_GATEWAY_UPSTREAM_ENDPOINT=http://127.0.0.1:18789/v1/chat/completions
GENERATION_GATEWAY_UPSTREAM_API_KEY=replace-with-openclaw-gateway-token
GENERATION_GATEWAY_ALLOWED_AGENTS=openclaw/total-recall-synthesis
GENERATION_GATEWAY_TIMEOUT_MS=30000
GENERATION_GATEWAY_MAX_INPUT_BYTES=1200000
GENERATION_GATEWAY_MAX_OUTPUT_BYTES=131072
GENERATION_GATEWAY_MAX_UPSTREAM_RESPONSE_BYTES=524288
