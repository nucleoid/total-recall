[Unit]
Description=Total Recall MCP Memory Server (HTTP)
After=postgresql.service

[Service]
Type=simple
WorkingDirectory=%h/.local/share/total-recall/current
ExecStart=/usr/bin/node %h/.local/share/total-recall/current/dist/server.js
EnvironmentFile=%h/projects/total-recall/.env
Environment=PORT=3003
Restart=always
RestartSec=3
StartLimitIntervalSec=300
StartLimitBurst=10

[Install]
WantedBy=default.target
