# Non-secret review template. Do not source until each referenced policy is owner-approved.
DEPLOYMENT_ENVIRONMENT=production

# All native synthesis policies must use this adapter contract and the dedicated OpenClaw agent target.
TOTAL_RECALL_SYNTHESIS_ENDPOINT=http://private-fuego-adapter:3010/v1/generate
TOTAL_RECALL_SYNTHESIS_AGENT=openclaw/total-recall-synthesis
# Each policy keeps a separate credentialEnv, but values may be the same scoped adapter token after approval.
# *_GENERATION_API_KEY=dedicated-worker-to-adapter-token

# Queue switches are already deployed; retain local embeddings and bounded concurrency.
MEMORY_INGESTION_QUEUE_ENABLED=true
MEMORY_INGESTION_UPDATE_ENABLED=true
MEMORY_INGESTION_DOCUMENT_ENABLED=true
MEMORY_INGESTION_SESSION_ENABLED=true

# Independent feature policy files (owner-only, mode 0600).
# CONSOLIDATION_POLICY_FILE=/etc/total-recall/policies/consolidation-v1.json
# REFLECTION_POLICY_FILE=/etc/total-recall/policies/reflection-v1.json
# SESSION_DISTILLATION_POLICY_FILE=/etc/total-recall/policies/session-distillation-v1.json
# ENTITY_EXTRACTION_POLICY_FILE=/etc/total-recall/policies/entity-extraction-v1.json
# TASTE_PROFILE_POLICY_FILE=/etc/total-recall/policies/taste-profile-v1.json

# Reversible rollout gates: classification/shadow first, mutations and demotion only after review.
CONTRADICTION_CLASSIFICATION_ENABLED=false
CONTRADICTION_AUTO_MUTATION_ENABLED=false
SUPERSEDED_SEARCH_DEMOTION_ENABLED=false
MEMORY_SUBSCRIPTION_CREATION_ENABLED=false
WEBHOOK_DELIVERY_ENABLED=false
