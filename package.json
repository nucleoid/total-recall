{
  "name": "total-recall",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "pretest": "npm run build",
    "typecheck:scripts": "tsc --project tsconfig.scripts.json",
    "test": "node --test --test-concurrency=1 --import tsx \"test/**/*.test.ts\" && npm run test:daily-sync && npm run test:access-level:db",
    "test:daily-sync": "node scripts/run-daily-sync-tests.mjs",
    "test:integration": "node --import tsx --test test/*.integration.test.ts",
    "test:watcher": "node --test --test-concurrency=1 --import tsx \"test/watcher/**/*.test.ts\"",
    "test:access-level": "tsx test/access-level.integration.test.ts",
    "test:access-level:db": "tsx test/access-level.db.ts",
    "test:agent-tenancy": "tsx --test test/agent-tenancy.integration.test.ts",
    "test:types": "tsc --noEmit --module Node16 --moduleResolution Node16 --target ES2022 --strict --esModuleInterop --skipLibCheck test/media-trusted-input-types.ts",
    "start": "node dist/index.js",
    "provision": "tsx scripts/provision-db.ts",
    "migrate": "tsx scripts/migrate.ts",
    "test:migrations": "tsx --test test/migrations/decay.integration.test.ts",
    "create-key": "tsx scripts/create-key.ts",
    "preseed": "tsx scripts/preseed-openclaw.ts",
    "preseed:claude": "tsx scripts/preseed-claude.ts",
    "start:http": "node dist/server.js",
    "start:stdio": "node dist/index.js",
    "preseed:gemini": "tsx scripts/preseed-gemini.ts",
    "repair:gemini-source-keys": "tsx scripts/repair-gemini-source-keys.ts",
    "watcher": "tsx src/watcher.ts",
    "start:watcher": "node dist/watcher.js",
    "preseed:chatgpt": "tsx scripts/preseed-chatgpt.ts",
    "decay:update": "tsx scripts/decay-update.ts",
    "repair:relevance-scores": "tsx scripts/repair-relevance-scores.ts",
    "repair:last-boosted-at": "tsx scripts/repair-last-boosted-at.ts",
    "repair:media-event-at": "tsx scripts/repair-media-event-at.ts",
    "media:repair-tags": "tsx scripts/repair-media-rollup-tags.ts",
    "repair:document-chunk-counts": "tsx scripts/repair-document-chunk-counts.ts",
    "repair:watcher-orphans": "tsx scripts/repair-watcher-orphans.ts",
    "index:media-event-at": "tsx scripts/create-media-event-at-index.ts",
    "index:document-idempotency": "tsx scripts/create-document-idempotency-index.ts",
    "reembed": "tsx scripts/reembed-all.ts",
    "spotify:auth": "tsx scripts/spotify-auth.ts",
    "spotify:sync": "tsx scripts/spotify-sync.ts",
    "spotify:repair-progress": "tsx scripts/repair-spotify-progress.ts",
    "repair:media-event-duplicates": "tsx scripts/repair-media-event-duplicates.ts",
    "ytmusic:auth": "tsx scripts/ytmusic-auth.ts",
    "ytmusic:auth-browser": "tsx scripts/ytmusic-auth-browser.ts",
    "ytmusic:sync": "tsx scripts/ytmusic-sync.ts",
    "plex:auth": "tsx scripts/plex-auth.ts",
    "plex:sync": "tsx scripts/plex-sync.ts",
    "preflight:media-keys": "tsx scripts/preflight-media-keys.ts",
    "test:plex": "node --test --import tsx test/connectors/plex-connector.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@types/cheerio": "^0.22.35",
    "@types/express": "^5.0.6",
    "cheerio": "^1.2.0",
    "chokidar": "^5.0.0",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "glob": "^13.0.6",
    "pg": "^8.13.1",
    "stream-json": "^3.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
