{
  "name": "total-recall",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run build:server && npm run build:dashboard",
    "build:server": "tsc",
    "build:dashboard": "tsx scripts/build-dashboard.ts",
    "pretest": "npm run build",
    "typecheck:scripts": "tsc --project tsconfig.scripts.json",
    "test": "node --test --test-concurrency=1 --import ./test/setup-embedding-env.mjs --import tsx \"test/**/*.test.ts\" && npm run test:python && npm run test:daily-sync && npm run test:access-level:db",
    "test:daily-sync": "node scripts/run-daily-sync-tests.mjs",
    "test:integration": "node --import ./test/setup-embedding-env.mjs --import tsx --test test/*.integration.test.ts",
    "test:contract": "node --test --test-concurrency=1 --import ./test/setup-embedding-env.mjs --import tsx test/openapi-contract.test.ts test/openapi-http.integration.test.ts",
    "test:watcher": "node --test --test-concurrency=1 --import ./test/setup-embedding-env.mjs --import tsx \"test/watcher/**/*.test.ts\"",
    "test:access-level": "node --import ./test/setup-embedding-env.mjs --import tsx test/access-level.integration.test.ts",
    "test:access-level:db": "node --import ./test/setup-embedding-env.mjs --import tsx test/access-level.db.ts",
    "test:agent-tenancy": "node --import ./test/setup-embedding-env.mjs --import tsx --test test/agent-tenancy.integration.test.ts",
    "test:types": "tsc --noEmit --module Node16 --moduleResolution Node16 --target ES2022 --strict --esModuleInterop --skipLibCheck test/media-trusted-input-types.ts",
    "start": "node dist/index.js",
    "provision": "tsx scripts/provision-db.ts",
    "migrate": "tsx scripts/migrate.ts",
    "test:migrations": "tsx --test test/migrations/decay.integration.test.ts",
    "create-key": "tsx scripts/create-key.ts",
    "rotate-key": "tsx scripts/rotate-key.ts",
    "memory:export": "tsx scripts/memory-export.ts",
    "memory:import": "tsx scripts/memory-import.ts",
    "preseed": "tsx scripts/preseed-openclaw.ts",
    "preseed:claude": "tsx scripts/preseed-claude.ts",
    "start:http": "node dist/server.js",
    "start:stdio": "node dist/index.js",
    "preseed:gemini": "tsx scripts/preseed-gemini.ts",
    "repair:gemini-source-keys": "tsx scripts/repair-gemini-source-keys.ts",
    "watcher": "tsx src/watcher.ts",
    "start:watcher": "node dist/watcher.js",
    "preseed:chatgpt": "tsx scripts/preseed-chatgpt.ts",
    "decay:update": "tsx scripts/decay-update.ts",
    "maintenance": "npm run decay:update",
    "consolidate": "tsx scripts/consolidate-memories.ts",
    "reflect": "tsx scripts/reflect.ts",
    "entity:enrich": "tsx scripts/entity-enrich.ts",
    "entity:backfill": "tsx scripts/entity-backfill.ts",
    "session:distill": "tsx scripts/session-distill.ts",
    "webhooks:deliver": "tsx scripts/webhook-delivery.ts",
    "deconsolidate": "tsx scripts/deconsolidate-memories.ts",
    "purge:deleted": "tsx scripts/purge-deleted.ts",
    "repair:relevance-scores": "tsx scripts/repair-relevance-scores.ts",
    "repair:last-boosted-at": "tsx scripts/repair-last-boosted-at.ts",
    "repair:media-event-at": "tsx scripts/repair-media-event-at.ts",
    "media:repair-tags": "tsx scripts/repair-media-rollup-tags.ts",
    "media:repair-dates": "tsx scripts/repair-media-rollup-dates.ts",
    "repair:document-chunk-counts": "tsx scripts/repair-document-chunk-counts.ts",
    "repair:watcher-orphans": "tsx scripts/repair-watcher-orphans.ts",
    "index:media-event-at": "tsx scripts/create-media-event-at-index.ts",
    "index:document-idempotency": "tsx scripts/create-document-idempotency-index.ts",
    "finalize:memory-lifecycle": "tsx scripts/finalize-memory-lifecycle.ts",
    "backfill:memory-validity": "tsx scripts/backfill-memory-validity.ts",
    "finalize:memory-validity": "tsx scripts/finalize-memory-validity.ts",
    "finalize:memory-supersession": "tsx scripts/finalize-memory-supersession.ts",
    "reembed": "tsx scripts/reembed-all.ts",
    "embedding:status": "tsx scripts/embedding-status.ts",
    "embedding:label": "tsx scripts/label-embeddings.ts",
    "spotify:auth": "tsx scripts/spotify-auth.ts",
    "spotify:sync": "tsx scripts/spotify-sync.ts",
    "spotify:repair-progress": "tsx scripts/repair-spotify-progress.ts",
    "repair:media-event-duplicates": "tsx scripts/repair-media-event-duplicates.ts",
    "ytmusic:auth": "tsx scripts/ytmusic-auth.ts",
    "ytmusic:auth-browser": "tsx scripts/ytmusic-auth-browser.ts",
    "ytmusic:preview-recovery": "tsx scripts/ytmusic-preview-recovery.ts",
    "ytmusic:sync": "tsx scripts/ytmusic-sync.ts",
    "plex:auth": "tsx scripts/plex-auth.ts",
    "plex:sync": "tsx scripts/plex-sync.ts",
    "preflight:media-keys": "tsx scripts/preflight-media-keys.ts",
    "test:plex": "node --test --import tsx test/connectors/plex-connector.test.ts",
    "test:python": "tsx scripts/run-python-tests.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@types/cheerio": "^0.22.35",
    "@types/express": "^5.0.6",
    "cheerio": "^1.2.0",
    "chokidar": "^5.0.0",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "glob": "^13.0.6",
    "pg": "^8.13.1",
    "stream-json": "^3.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^7.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.25.12",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "yaml": "^2.9.0"
  }
}
