# shellcheck shell=bash disable=SC2034
# Copy to a deployment-owned file (mode 0600) and replace every path.
# This dedicated file is shell-safe; daily-sync.sh never sources application .env files.
# Install this scheduler on the Dappnode account that owns the active release.
REQUIRED_RUN_AS_USER=cass
# The deployment already owns the watcher. This safety-net job validates it and never starts/adopts a duplicate.
WATCHER_OWNERSHIP=external
NODE_BIN=/home/cass/.nvm/versions/node/v22.19.0/bin/node
PROJECT_DIR=/home/cass/total-recall-current
MCPORTER_BIN=/home/cass/.local/bin/mcporter
MCPORTER_CONFIG=/home/cass/.config/mcporter.json
PYTHON3_BIN=/usr/bin/python3
STARTUP_TIMEOUT_SECONDS=5
LOCK_TIMEOUT_SECONDS=10
STATS_TIMEOUT_SECONDS=15
